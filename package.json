{
  "name": "@bi-analytics/arness-back",
  "version": "0.2.0",
  "description": "Harness de agentes IA (Claude Code, Codex, Gemini CLI, Cursor) para backends NestJS de analítica",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bi-analytics-linktic/harness-back.git"
  },
  "type": "module",
  "homepage": "https://github.com/bi-analytics-linktic/harness-back#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "arness": "bin/arness.mjs"
  },
  "files": [
    "bin/",
    "harness/",
    "!harness/progress.md",
    "!harness/.arness.json",
    "!harness/arness.config.json",
    "!harness/.arness-backup/",
    "!harness/decisiones/[0-9]*.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "./harness/init.sh",
    "pack:check": "pnpm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "harness",
    "agents",
    "claude-code",
    "codex",
    "nestjs"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
